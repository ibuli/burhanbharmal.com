{
  "name": "burhanbharmal-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "bun scripts/content.ts && bun scripts/brand-assets.ts",
    "dev": "bun run content && vite --host 127.0.0.1 --port 4173",
    "build": "bun run content && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests vite.config.ts --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test tests",
    "check": "bun run content && bun run lint && bun run format:check && bun run test && bun run build && bun run typecheck",
    "cf:typegen": "wrangler types --include-runtime=false",
    "deploy": "bun run check && wrangler deploy && bun run deploy:redirect",
    "deploy:redirect": "wrangler deploy --config wrangler.redirect.jsonc",
    "deploy:dry-run": "wrangler deploy --dry-run && wrangler deploy --config wrangler.redirect.jsonc --dry-run",
    "audit": "lighthouse http://localhost:4173 --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=.research/lighthouse-ssr.json --chrome-flags=--headless --quiet",
    "test:ssr": "bun scripts/smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261128.1",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fontkit": "^3.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.1.0",
    "lighthouse": "^13.6.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14"
}
